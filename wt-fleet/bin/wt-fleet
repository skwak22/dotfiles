#!/usr/bin/env bash
# wt-fleet — Portable Git Worktree + tmux Multi-Agent Orchestrator
#
# Zero external dependencies beyond bash, git, and tmux (works on macOS & Linux).
# Manages isolated git worktrees (.worktrees/<name> on branch agent/<name>)
# paired with tmux panes (capped at 4 panes per window) and cross-pane messaging.

set -euo pipefail

# Load optional machine-local overrides (e.g. WT_AGENT_CLI) outside of dotfiles
[[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/wt-fleet/config" ]] && source "${XDG_CONFIG_HOME:-$HOME/.config}/wt-fleet/config"

VERSION="1.1.0"
MAX_PANES_PER_WINDOW="${WT_MAX_PANES:-4}"
DEFAULT_WORKER_PERSONA="${WT_WORKER_PERSONA:-worker}"
DEFAULT_MAYOR_PERSONA="${WT_MAYOR_PERSONA:-mayor}"
DEFAULT_LAYOUT="${WT_LAYOUT:-tiled}"
DEFAULT_DELIVERY_MODE="${WT_DELIVERY_MODE:-smart}"

# Inspect parent process tree ($PPID) to see if wt-fleet was invoked from inside an active agent CLI
detect_parent_agent_cli() {
  local pid="${PPID:-}"
  local depth=0
  local candidates=(claude codex gemini aider)
  if [[ -n "${WT_AGENT_CLI:-}" ]]; then
    candidates+=("$WT_AGENT_CLI")
  fi
  while [[ -n "$pid" && "$pid" != "0" && "$pid" != "1" && $depth -lt 8 ]]; do
    local comm args
    comm=$(ps -o comm= -p "$pid" 2>/dev/null | tr -d '[:space:]' || true)
    args=$(ps -o args= -p "$pid" 2>/dev/null || true)
    for candidate in "${candidates[@]}"; do
      if [[ "$comm" == "$candidate" ]] || [[ "$args" =~ (^|[[:space:]/])${candidate}([[:space:]]|$) ]]; then
        if command -v "$candidate" >/dev/null 2>&1; then
          echo "$candidate"
          return 0
        fi
      fi
    done
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d '[:space:]' || true)
    depth=$((depth + 1))
  done
  return 1
}

# Auto-detect agent CLI if WT_AGENT_CLI is not explicitly set
detect_agent_cli() {
  local parent_cli=""
  parent_cli=$(detect_parent_agent_cli || true)
  if [[ -n "$parent_cli" ]]; then
    echo "$parent_cli"
    return 0
  fi
  if [[ -n "${WT_AGENT_CLI:-}" ]]; then
    echo "$WT_AGENT_CLI"
    return 0
  fi
  for candidate in claude codex gemini aider; do
    if command -v "$candidate" >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done
  echo "claude"
}

DEFAULT_AGENT_CLI="$(detect_agent_cli)"

# --- Helpers ---

die() {
  printf "\033[1;31merror:\033[0m %s\n" "$*" >&2
  exit 1
}

info() {
  printf "\033[1;36m[wt-fleet]\033[0m %s\n" "$*"
}

warn() {
  printf "\033[1;33m[wt-fleet warn]\033[0m %s\n" "$*" >&2
}

require_tmux() {
  command -v tmux >/dev/null 2>&1 || die "tmux is not installed or not in PATH"
  [[ -n "${TMUX:-}" || -n "${TMUX_PANE:-}" ]] || die "must be run inside an active tmux session (\$TMUX / \$TMUX_PANE unset)"
}

# Resolve main repository root even when invoked from inside a linked git worktree.
get_main_repo_root() {
  local common_dir=""
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  if [[ -z "$common_dir" && -n "${TMUX_PANE:-}" ]]; then
    local pane_cwd
    pane_cwd=$(tmux display-message -t "$TMUX_PANE" -p '#{pane_current_path}' 2>/dev/null || true)
    if [[ -n "$pane_cwd" ]]; then
      common_dir=$(git -C "$pane_cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
    fi
  fi
  [[ -n "$common_dir" ]] || die "not inside a git repository (run from your git repo root or worktree)"
  if [[ "$(basename "$common_dir")" == ".git" ]]; then
    dirname "$common_dir"
  else
    echo "$common_dir"
  fi
}

# Ensure .worktrees/ and .wt-*.md files are excluded locally via .git/info/exclude
# so they never dirty git status in the main repo or any worktree.
ensure_git_excludes() {
  local repo_root="$1"
  local common_dir
  common_dir=$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)
  local exclude_file="${common_dir}/info/exclude"
  mkdir -p "$(dirname "$exclude_file")"
  touch "$exclude_file"
  for pattern in ".worktrees/" ".wt-task.md" ".wt-review.md" ".wt-spec.md"; do
    if ! grep -qxF "$pattern" "$exclude_file" 2>/dev/null; then
      echo "$pattern" >> "$exclude_file"
    fi
  done
}

fleet_dir() {
  local repo_root="$1"
  echo "${repo_root}/.worktrees/.fleet"
}

inbox_file() {
  local repo_root="$1"
  local fdir
  fdir=$(fleet_dir "$repo_root")
  echo "${fdir}/inbox.log"
}

inbox_count() {
  local repo_root="$1"
  local ibox
  ibox=$(inbox_file "$repo_root")
  if [[ -s "$ibox" ]]; then
    grep -c '[^[:space:]]' "$ibox" 2>/dev/null || echo "0"
  else
    echo "0"
  fi
}

validate_delivery_mode() {
  local mode="$1"
  case "$mode" in
    smart|inbox|push) return 0 ;;
    *) die "invalid delivery mode: '$mode' (expected: smart, inbox, or push)" ;;
  esac
}

registry_md_path() {
  local repo_root="$1"
  echo "${repo_root}/.worktrees/REGISTRY.md"
}

sanitize_name() {
  local raw="$1"
  echo "$raw" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^-+//; s/-+$//'
}

# --- Native tmux Cross-Pane Primitives (Zero External Binary Dependencies) ---

pane_is_alive() {
  local pane_id="$1"
  [[ -n "$pane_id" ]] || return 1
  tmux display-message -t "$pane_id" -p '#{pane_id}' >/dev/null 2>&1
}

pane_set_label() {
  local pane_id="$1"
  local label="$2"
  tmux set-option -p -t "$pane_id" @name "$label" >/dev/null 2>&1 || true
}

pane_capture() {
  local pane_id="$1"
  local lines="${2:-40}"
  tmux capture-pane -t "$pane_id" -p -J -S "-${lines}"
}

# Return 0 if line is a TUI horizontal rule border ('───...')
is_tui_rule_line() {
  local line="$1"
  [[ "$line" == *"───"* ]] || return 1
  local rest="$line"
  rest="${rest//─/}"
  rest="${rest//━/}"
  rest="${rest//═/}"
  rest="${rest//╭/}"
  rest="${rest//╮/}"
  rest="${rest//╰/}"
  rest="${rest//╯/}"
  rest="${rest//┌/}"
  rest="${rest//┐/}"
  rest="${rest//└/}"
  rest="${rest//┘/}"
  rest="${rest//[[:space:]]/}"
  [[ -z "$rest" ]]
}

# Return 0 if line is part of an interactive modal or numbered cursor menu
is_modal_line() {
  local line="$1"
  if [[ "$line" =~ ^[[:space:]]*[\>❯›][[:space:]]*[0-9]+\.[[:space:]] ]]; then
    return 0
  fi
  local stripped="${line//\'Requesting permission for:\'/}"
  stripped="${stripped//\'Run this command\?\'/}"
  stripped="${stripped//\'↑\/↓ Navigate\'/}"
  stripped="${stripped//\'Select an option\'/}"
  stripped="${stripped//\'Do you want to proceed\?\'/}"
  stripped="${stripped//\'Yes, and don\'t ask again\'/}"
  stripped="${stripped//\'Allow once\'/}"
  case "$stripped" in
    *"Requesting permission for:"*|*"Run this command?"*|*"↑/↓ Navigate"*|*"Select an option"*|*"Do you want to proceed?"*|*"Yes, and don't ask again"*|*"Allow once"*)
      return 0
      ;;
  esac
  return 1
}

# Return 0 if text after prompt prefix ('>', '❯', '›') is active user typing (NOT empty and NOT a built-in TUI placeholder)
prompt_text_is_active_input() {
  local raw="$1"
  local trimmed="${raw#"${raw%%[![:space:]]*}"}"
  trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"

  [[ -n "$trimmed" ]] || return 1

  case "$trimmed" in
    "Accept-edits mode:"*|"Plan mode:"*|"Best-of-N mode:"*|"Type your message"*|"Press "*|"Try \""*|"Explain this codebase"*|"Write tests for"*)
      return 1
      ;;
  esac
  return 0
}

# Deterministic helper: inspect captured pane text (from $1 or stdin).
# Returns 0 if safe to inject, 1 if unsafe/busy (user typing in prompt or interactive modal open).
pane_check_input_safety_from_text() {
  local raw_text=""
  if (( $# >= 1 )); then
    raw_text="$1"
  else
    raw_text=$(cat)
  fi

  local all_lines=()
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    all_lines+=("$line")
  done <<< "$raw_text"

  # Strip trailing blank lines
  local n=${#all_lines[@]}
  while (( n > 0 )); do
    local last="${all_lines[$((n - 1))]}"
    if [[ -z "${last//[[:space:]]/}" ]]; then
      unset "all_lines[$((n - 1))]"
      n=$((n - 1))
    else
      break
    fi
  done

  if (( n == 0 )); then
    return 0
  fi

  # Inspect the bottom ~20 non-trailing-blank lines
  local start_idx=0
  if (( n > 20 )); then
    start_idx=$((n - 20))
  fi
  local lines=()
  local i
  for (( i = start_idx; i < n; i++ )); do
    lines+=("${all_lines[$i]}")
  done
  local count=${#lines[@]}

  # 1. Check for interactive modals or numbered selection menus in the bottom lines
  for (( i = 0; i < count; i++ )); do
    if is_modal_line "${lines[$i]}"; then
      return 1
    fi
  done

  # 2. Locate TUI input box at the bottom (between horizontal rule lines '───...')
  local rule_indices=()
  for (( i = 0; i < count; i++ )); do
    if is_tui_rule_line "${lines[$i]}"; then
      rule_indices+=("$i")
    fi
  done
  local num_rules=${#rule_indices[@]}

  if (( num_rules >= 2 )); then
    local top_idx="${rule_indices[$((num_rules - 2))]}"
    local bot_idx="${rule_indices[$((num_rules - 1))]}"
    if (( count - 1 - bot_idx <= 4 )); then
      local box_lines=()
      for (( i = top_idx + 1; i < bot_idx; i++ )); do
        box_lines+=("${lines[$i]}")
      done
      if (( ${#box_lines[@]} == 0 )); then
        return 0
      elif (( ${#box_lines[@]} > 1 )); then
        return 1
      else
        local pline="${box_lines[0]}"
        pline="${pline#"${pline%%[![:space:]]*}"}"
        [[ "$pline" == │* ]] && pline="${pline#│}"
        pline="${pline%"${pline##*[![:space:]]}"}"
        [[ "$pline" == *│ ]] && pline="${pline%│}"
        if [[ "$pline" =~ ^[[:space:]]*[\>❯›](.*)$ ]]; then
          if prompt_text_is_active_input "${BASH_REMATCH[1]}"; then
            return 1
          fi
          return 0
        elif [[ -n "${pline//[[:space:]]/}" ]]; then
          return 1
        fi
        return 0
      fi
    fi
  elif (( num_rules == 1 )); then
    local top_idx="${rule_indices[0]}"
    if (( count - 1 - top_idx <= 6 )); then
      local box_lines=()
      for (( i = top_idx + 1; i < count; i++ )); do
        case "${lines[$i]}" in
          "esc to cancel"*|*"bypass permissions"*|*"shift+tab to cycle"*) continue ;;
        esac
        box_lines+=("${lines[$i]}")
      done
      if (( ${#box_lines[@]} == 0 )); then
        return 0
      elif (( ${#box_lines[@]} > 1 )); then
        return 1
      else
        local pline="${box_lines[0]}"
        if [[ "$pline" =~ ^[[:space:]]*[\>❯›](.*)$ ]]; then
          if prompt_text_is_active_input "${BASH_REMATCH[1]}"; then
            return 1
          fi
          return 0
        elif [[ -n "${pline//[[:space:]]/}" ]]; then
          return 1
        fi
        return 0
      fi
    fi
  fi

  # 3. Plain shell prompt or bare prompt fallback (no active '───' TUI box)
  if (( count > 1 )) && [[ "${lines[0]}" =~ ^[[:space:]]*[\>❯›] ]]; then
    return 1
  fi

  local last_line="${lines[$((count - 1))]}"
  if [[ "$last_line" =~ ^[[:space:]]*[\>❯›](.*)$ ]]; then
    if prompt_text_is_active_input "${BASH_REMATCH[1]}"; then
      return 1
    fi
    return 0
  fi

  if [[ "$last_line" =~ [$%#\>❯›][[:space:]]*$ ]]; then
    return 0
  fi
  if [[ "$last_line" =~ ^[[:space:]]*[$%#\>❯›][[:space:]]+[^[:space:]] ]] \
    || [[ "$last_line" =~ ^[^[:space:]].*[$%#\>❯›][[:space:]]+[^[:space:]] ]]; then
    return 1
  fi

  return 0
}

# Capture the bottom ~20 lines of <pane_id> and check if it is safe to inject via send-keys.
pane_is_safe_to_inject() {
  local pane_id="$1"
  pane_is_alive "$pane_id" || return 1
  local captured
  captured=$(tmux capture-pane -t "$pane_id" -p -J -S -20 2>/dev/null || true)
  pane_check_input_safety_from_text "$captured"
}

LAST_DELIVERY_RESULT=""

# Send a tagged message into another agent's interactive TUI pane and submit with Enter,
# or fall back to queuing in .worktrees/.fleet/inbox.log when target pane is busy or mode is 'inbox'.
pane_send_message() {
  local target_pane="$1"
  local text="$2"
  local delivery_mode="${3:-${WT_DELIVERY_MODE:-$DEFAULT_DELIVERY_MODE}}"
  local target_label="${4:-}"
  local repo_root="${5:-}"

  validate_delivery_mode "$delivery_mode"

  local sender_pane="${TMUX_PANE:-}"
  local from="${WT_WORKER_NAME:-}"
  local session_win="?"
  if [[ -n "$sender_pane" ]] && pane_is_alive "$sender_pane"; then
    local lbl
    lbl=$(tmux display-message -t "$sender_pane" -p '#{@name}' 2>/dev/null || true)
    if [[ -z "$from" ]]; then
      from="${lbl:-$sender_pane}"
    fi
    session_win=$(tmux display-message -t "$sender_pane" -p '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || true)
  fi
  from="${from:-orchestrator}"

  if [[ -z "$target_label" ]] && [[ -n "$target_pane" ]] && pane_is_alive "$target_pane"; then
    target_label=$(tmux display-message -t "$target_pane" -p '#{@name}' 2>/dev/null || true)
  fi
  target_label="${target_label:-mayor}"

  local should_queue=false
  local queue_reason=""
  if [[ "$delivery_mode" == "inbox" ]]; then
    should_queue=true
    queue_reason="delivery mode is 'inbox'"
  elif [[ "$delivery_mode" == "smart" ]]; then
    if ! pane_is_safe_to_inject "$target_pane"; then
      should_queue=true
      queue_reason="target pane (${target_pane}) has active user input or an interactive modal"
    fi
  fi

  if $should_queue; then
    if [[ -z "$repo_root" ]]; then
      repo_root=$(get_main_repo_root)
    fi
    local fdir
    fdir=$(fleet_dir "$repo_root")
    mkdir -p "$fdir"
    local ibox
    ibox=$(inbox_file "$repo_root")
    local ts
    ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local clean_msg="${text//$'\n'/ }"
    printf '[%s] [from:%s to:%s pane:%s] %s\n' \
      "$ts" "$from" "$target_label" "${sender_pane:-?}" "$clean_msg" >> "$ibox"
    tmux display-message -d 4000 "[wt-fleet] Queued reply from ${from} in inbox (target pane busy)" >/dev/null 2>&1 || true
    info "Queued reply from '${from}' to '${target_label}' in inbox (${ibox}) because ${queue_reason}."
    LAST_DELIVERY_RESULT="queued"
    return 0
  fi

  local header="[wt-fleet from:${from} pane:${sender_pane:-?} at:${session_win}]"
  tmux send-keys -t "$target_pane" -l -- "${header} ${text}"
  sleep 0.15
  tmux send-keys -t "$target_pane" Enter
  LAST_DELIVERY_RESULT="injected"
}

# Resolve a pane label within the current repo (.fleet/<name>.env) or current tmux session.
resolve_pane_quiet() {
  local label="$1"
  local repo_root="${2:-}"
  if [[ -z "$repo_root" ]]; then
    repo_root=$(get_main_repo_root 2>/dev/null || true)
  fi

  # 1. Check repo-specific state file first
  if [[ -n "$repo_root" ]]; then
    local fdir
    fdir=$(fleet_dir "$repo_root")
    if [[ "$label" == "mayor" && -f "${fdir}/mayor.pane" ]]; then
      local saved_mayor
      saved_mayor=$(cat "${fdir}/mayor.pane" 2>/dev/null || true)
      if pane_is_alive "$saved_mayor"; then
        echo "$saved_mayor"
        return 0
      fi
    elif [[ -f "${fdir}/${label}.env" ]]; then
      local saved_pane
      saved_pane=$(awk -F= '/^PANE_ID=/{print $2}' "${fdir}/${label}.env" | tr -d "'\"" 2>/dev/null || true)
      if pane_is_alive "$saved_pane"; then
        echo "$saved_pane"
        return 0
      fi
    fi
  fi

  # 2. Search panes in the current tmux session
  local session_match=""
  if [[ -n "${TMUX_PANE:-}" ]]; then
    session_match=$(tmux list-panes -s -t "$TMUX_PANE" -F '#{pane_id} #{@name}' 2>/dev/null \
      | awk -v lbl="$label" '$2 == lbl { print $1; exit }' || true)
    if pane_is_alive "$session_match"; then
      echo "$session_match"
      return 0
    fi
  fi

  # 3. Fallback: search all panes on the tmux server
  tmux list-panes -a -F '#{pane_id} #{@name}' 2>/dev/null \
    | awk -v lbl="$label" '$2 == lbl { print $1; exit }' || true
}

# Ensure the orchestrator pane for this repo/session is labeled 'mayor'
ensure_mayor_pane() {
  local repo_root
  repo_root=$(get_main_repo_root)
  local fdir
  fdir=$(fleet_dir "$repo_root")
  mkdir -p "$fdir"

  local mayor_pane
  mayor_pane=$(resolve_pane_quiet "mayor" "$repo_root")
  if pane_is_alive "$mayor_pane"; then
    echo "$mayor_pane" > "${fdir}/mayor.pane"
    echo "$mayor_pane"
    return 0
  fi
  if [[ -n "${TMUX_PANE:-}" ]] && pane_is_alive "$TMUX_PANE"; then
    pane_set_label "$TMUX_PANE" "mayor"
    local cur_branch
    cur_branch=$(git -C "$repo_root" branch --show-current 2>/dev/null || echo "main")
    tmux set-option -p -t "$TMUX_PANE" @branch "$cur_branch" >/dev/null 2>&1 || true
    echo "$TMUX_PANE" > "${fdir}/mayor.pane"
    echo "$TMUX_PANE"
    return 0
  fi
  die "could not determine or label the 'mayor' tmux pane"
}

# Rebalance panes in a window based on count (2 -> even-horizontal, 3..4 -> tiled/custom)
rebalance_window() {
  local win_target="$1"
  local requested_layout="${2:-$DEFAULT_LAYOUT}"
  local count
  count=$(tmux list-panes -t "$win_target" 2>/dev/null | wc -l | tr -d ' ')
  if (( count <= 1 )); then
    return 0
  elif (( count == 2 )) && [[ "$requested_layout" == "tiled" ]]; then
    tmux select-layout -t "$win_target" even-horizontal >/dev/null 2>&1 || true
  else
    tmux select-layout -t "$win_target" "$requested_layout" >/dev/null 2>&1 || true
  fi
}

# Allocate a non-conflicting port offset (100, 200, ..., 900)
allocate_port_offset() {
  local fdir="$1"
  local offset=100
  while (( offset <= 900 )); do
    local used=false
    for env_file in "$fdir"/*.env; do
      [[ -f "$env_file" ]] || continue
      [[ "$(basename "$env_file")" == "mayor.env" ]] && continue
      if grep -q "^PORT_OFFSET=${offset}$" "$env_file" 2>/dev/null; then
        used=true
        break
      fi
    done
    if ! $used; then
      echo "$offset"
      return 0
    fi
    offset=$(( offset + 100 ))
  done
  echo "100"
}

# Resolve the active agent CLI (claude, codex, gemini, aider).
# Precedence: explicit CLI override > .worktrees/.fleet/mayor.env > DEFAULT_AGENT_CLI (parent process / WT_AGENT_CLI / PATH)
resolve_agent_cli() {
  local repo_root="${1:-}"
  local override="${2:-}"
  if [[ -n "$override" ]]; then
    echo "$override"
    return 0
  fi
  if [[ -z "$repo_root" ]]; then
    repo_root=$(get_main_repo_root 2>/dev/null || true)
  fi
  if [[ -n "$repo_root" ]]; then
    local fdir
    fdir=$(fleet_dir "$repo_root")
    if [[ -f "${fdir}/mayor.env" ]]; then
      local saved_cli
      saved_cli=$(awk -F= '/^AGENT_CLI=/{print $2}' "${fdir}/mayor.env" | tr -d "'\"" 2>/dev/null || true)
      if [[ -n "$saved_cli" ]]; then
        echo "$saved_cli"
        return 0
      fi
    fi
  fi
  echo "$DEFAULT_AGENT_CLI"
}

# Determine whether --dangerously-skip-permissions is active.
# Precedence: explicit CLI override ("1" or "0") > WT_SKIP_PERMISSIONS env > .worktrees/.fleet/mayor.env > "0"
resolve_skip_permissions() {
  local repo_root="${1:-}"
  local override="${2:-}"
  if [[ "$override" == "1" || "$override" == "0" ]]; then
    echo "$override"
    return 0
  fi
  case "${WT_SKIP_PERMISSIONS:-}" in
    1|true|TRUE|yes|YES)
      echo "1"
      return 0
      ;;
    0|false|FALSE|no|NO)
      echo "0"
      return 0
      ;;
  esac
  if [[ -z "$repo_root" ]]; then
    repo_root=$(get_main_repo_root 2>/dev/null || true)
  fi
  if [[ -n "$repo_root" ]]; then
    local fdir
    fdir=$(fleet_dir "$repo_root")
    if [[ -f "${fdir}/mayor.env" ]]; then
      local saved_skip
      saved_skip=$(awk -F= '/^SKIP_PERMISSIONS=/{print $2}' "${fdir}/mayor.env" | tr -d "'\"" 2>/dev/null || true)
      if [[ "$saved_skip" == "1" || "$saved_skip" == "true" ]]; then
        echo "1"
        return 0
      fi
    fi
  fi
  echo "0"
}

# Build CLI invocation string for a worker pane across supported agent CLIs
build_worker_launch_cmd() {
  local cli="$1"
  local persona="$2"
  local boot_prompt="${3:-}"
  local skip_perms="${4:-${WT_SKIP_PERMISSIONS:-0}}"

  local skip_enabled=false
  case "$skip_perms" in
    1|true|TRUE|yes|YES|--dangerously-skip-permissions|--dangerously-bypass-approvals-and-sandbox)
      skip_enabled=true
      ;;
  esac

  local base_cmd
  base_cmd=$(basename "$cli")

  case "$base_cmd" in
    claude)
      local flag=""
      if [[ -n "$persona" && "$persona" != "default" && "$persona" != "none" ]]; then
        flag="--agent ${persona}"
      fi
      if $skip_enabled; then
        flag="${flag:+$flag }--dangerously-skip-permissions"
      fi
      if [[ -n "$boot_prompt" ]]; then
        echo "${cli}${flag:+ $flag} $(printf '%q' "$boot_prompt")"
      else
        echo "${cli}${flag:+ $flag}"
      fi
      ;;
    codex)
      local flag=""
      if $skip_enabled; then
        flag="--dangerously-bypass-approvals-and-sandbox"
      fi
      local codex_prompt="$boot_prompt"
      if [[ -n "$persona" && "$persona" != "default" && "$persona" != "none" ]]; then
        local persona_prefix="First read ~/.codex/agents/${persona}.md and adopt its operating rules."
        if [[ -n "$codex_prompt" ]]; then
          codex_prompt="${persona_prefix} ${codex_prompt}"
        else
          codex_prompt="${persona_prefix}"
        fi
      fi
      if [[ -n "$codex_prompt" ]]; then
        echo "${cli}${flag:+ $flag} $(printf '%q' "$codex_prompt")"
      else
        echo "${cli}${flag:+ $flag}"
      fi
      ;;
    aider)
      local flag=""
      if $skip_enabled; then
        flag="--yes-always"
      fi
      if [[ -n "$boot_prompt" ]]; then
        echo "${cli}${flag:+ $flag} --message $(printf '%q' "$boot_prompt")"
      else
        echo "${cli}${flag:+ $flag}"
      fi
      ;;
    *)
      local flag=""
      if [[ -n "$persona" && "$persona" != "default" && "$persona" != "none" ]]; then
        flag="--agent ${persona}"
      fi
      if $skip_enabled; then
        flag="${flag:+$flag }--dangerously-skip-permissions"
      fi
      if [[ -n "$boot_prompt" ]]; then
        echo "${cli}${flag:+ $flag} -i $(printf '%q' "$boot_prompt")"
      else
        echo "${cli}${flag:+ $flag}"
      fi
      ;;
  esac
}

# Write/update .worktrees/REGISTRY.md so the Mayor agent and user have a live ledger
update_registry_md() {
  local repo_root="$1"
  local fdir
  fdir=$(fleet_dir "$repo_root")
  mkdir -p "$fdir"
  local reg_file
  reg_file=$(registry_md_path "$repo_root")

  local mayor_pane
  mayor_pane=$(resolve_pane_quiet "mayor" "$repo_root")
  local active_cli
  active_cli=$(resolve_agent_cli "$repo_root")
  local skip_perms
  skip_perms=$(resolve_skip_permissions "$repo_root")
  local ibox
  ibox=$(inbox_file "$repo_root")
  local icount
  icount=$(inbox_count "$repo_root")

  {
    echo "# Worktree Fleet Registry"
    echo ""
    echo "- **Repository Root**: \`${repo_root}\`"
    echo "- **Mayor Pane**: \`${mayor_pane:-unregistered}\`"
    echo "- **Agent CLI**: \`${active_cli}\`"
    echo "- **Max Panes Per Window**: \`${MAX_PANES_PER_WINDOW}\`"
    echo "- **Inbox**: \`${icount} queued\`"
    if [[ "$skip_perms" == "1" ]]; then
      echo "- **Permissions**: \`SKIP (--dangerously-skip-permissions)\`"
    fi
    echo "- **Updated At**: \`$(date -u +"%Y-%m-%dT%H:%M:%SZ")\`"
    echo ""
    echo "## Active Workers"
    echo ""
    echo "| Worker | Pane | Status | Branch | Commits Ahead | Working Tree | Port Offset | Last Task / Reply |"
    echo "| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |"

    local found=false
    for env_file in "$fdir"/*.env; do
      [[ -f "$env_file" ]] || continue
      [[ "$(basename "$env_file")" == "mayor.env" ]] && continue
      found=true
      # shellcheck disable=SC1090
      source "$env_file"
      local live_pane
      live_pane=$(resolve_pane_quiet "$WORKER_NAME" "$repo_root")
      local pane_status="$STATUS"
      if ! pane_is_alive "$live_pane"; then
        live_pane="closed"
        pane_status="PANE_CLOSED"
      fi

      local ahead="0"
      local dirty="clean"
      if [[ -d "$WORKTREE_PATH" ]]; then
        ahead=$(git -C "$WORKTREE_PATH" rev-list --count "${BASE_BRANCH}..HEAD" 2>/dev/null || echo "?")
        if [[ -n "$(git -C "$WORKTREE_PATH" status --porcelain 2>/dev/null)" ]]; then
          dirty="modified"
        fi
      else
        dirty="missing"
      fi

      local summary="${LAST_REPLY:-$LAST_TASK}"
      summary="${summary//|/\\|}"
      summary="${summary//$'\n'/ }"
      if (( ${#summary} > 80 )); then
        summary="${summary:0:77}..."
      fi

      echo "| \`${WORKER_NAME}\` | \`${live_pane}\` | **${pane_status}** | \`${BRANCH}\` | +${ahead} | ${dirty} | +${PORT_OFFSET} | ${summary} |"
    done

    if ! $found; then
      echo "| *(none)* | - | - | - | - | - | - | - |"
    fi

    if (( icount > 0 )) && [[ -s "$ibox" ]]; then
      echo ""
      echo "## Queued Inbox Messages (${icount})"
      echo ""
      while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" ]] || continue
        echo "- \`${line}\`"
      done < "$ibox"
    fi
  } > "$reg_file"
}

# --- Subcommands ---

cmd_init() {
  require_tmux
  local skip_override=""
  local cli_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dangerously-skip-permissions|--dangerously-bypass-approvals-and-sandbox)
        skip_override="1"; shift ;;
      --no-skip-permissions)
        skip_override="0"; shift ;;
      --cli)
        [[ $# -ge 2 ]] || die "missing value for --cli"
        cli_override="$2"; shift 2 ;;
      --cli=*)
        cli_override="${1#*=}"; shift ;;
      -h|--help)
        usage; exit 0 ;;
      *)
        die "unknown flag for init: $1" ;;
    esac
  done

  local repo_root
  repo_root=$(get_main_repo_root)
  ensure_git_excludes "$repo_root"
  local fdir
  fdir=$(fleet_dir "$repo_root")
  mkdir -p "$fdir"

  local mayor_pane="${TMUX_PANE}"
  pane_set_label "$mayor_pane" "mayor"
  echo "$mayor_pane" > "${fdir}/mayor.pane"
  local cur_branch
  cur_branch=$(git -C "$repo_root" branch --show-current 2>/dev/null || echo "main")
  tmux set-option -p -t "$mayor_pane" @branch "$cur_branch" >/dev/null 2>&1 || true

  local skip_perms
  skip_perms=$(resolve_skip_permissions "$repo_root" "$skip_override")
  local active_cli=""
  if [[ -n "$cli_override" ]]; then
    active_cli="$cli_override"
  elif [[ -n "${WT_AGENT_CLI:-}" ]]; then
    active_cli="$WT_AGENT_CLI"
  else
    active_cli=$(detect_parent_agent_cli || true)
    [[ -z "$active_cli" ]] && active_cli=$(resolve_agent_cli "$repo_root")
  fi
  cat > "${fdir}/mayor.env" <<EOF
MAYOR_PANE=$(printf '%q' "$mayor_pane")
AGENT_CLI=$(printf '%q' "$active_cli")
SKIP_PERMISSIONS=$(printf '%q' "$skip_perms")
EOF
  export WT_AGENT_CLI="$active_cli"
  if [[ "$skip_perms" == "1" ]]; then
    export WT_SKIP_PERMISSIONS=1
  else
    export WT_SKIP_PERMISSIONS=0
  fi

  update_registry_md "$repo_root"
  info "Initialized wt-fleet in ${repo_root}"
  info "Current pane (${mayor_pane}) registered as 'mayor' on branch '${cur_branch}' (CLI: ${active_cli})."
  if [[ "$skip_perms" == "1" ]]; then
    info "Permissions: SKIP (--dangerously-skip-permissions enabled for Mayor & workers)"
  fi
  info "Registry: $(registry_md_path "$repo_root")"
}

cmd_mayor() {
  local skip_override=""
  local cli_override=""
  local cli_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dangerously-skip-permissions|--dangerously-bypass-approvals-and-sandbox)
        skip_override="1"; shift ;;
      --no-skip-permissions)
        skip_override="0"; shift ;;
      --cli)
        [[ $# -ge 2 ]] || die "missing value for --cli"
        cli_override="$2"; shift 2 ;;
      --cli=*)
        cli_override="${1#*=}"; shift ;;
      -h|--help)
        usage; exit 0 ;;
      *)
        cli_args+=("$1"); shift ;;
    esac
  done

  local init_flags=()
  [[ "$skip_override" == "1" ]] && init_flags+=("--dangerously-skip-permissions")
  [[ "$skip_override" == "0" ]] && init_flags+=("--no-skip-permissions")
  [[ -n "$cli_override" ]] && init_flags+=("--cli" "$cli_override")

  cmd_init ${init_flags[@]+"${init_flags[@]}"}

  local repo_root
  repo_root=$(get_main_repo_root)
  local skip_perms
  skip_perms=$(resolve_skip_permissions "$repo_root" "$skip_override")
  local active_cli
  active_cli=$(resolve_agent_cli "$repo_root" "$cli_override")
  local base_cmd
  base_cmd=$(basename "$active_cli")

  if [[ "$skip_perms" == "1" ]]; then
    export WT_SKIP_PERMISSIONS=1
  else
    export WT_SKIP_PERMISSIONS=0
  fi

  local final_args=()
  case "$base_cmd" in
    codex)
      [[ "$skip_perms" == "1" ]] && final_args+=("--dangerously-bypass-approvals-and-sandbox")
      if (( ${#cli_args[@]} > 0 )); then
        final_args+=("${cli_args[@]}")
      else
        final_args+=("Read and adopt ~/.codex/agents/${DEFAULT_MAYOR_PERSONA}.md as your Mayor orchestrator persona (wt-fleet init is already complete for this pane).")
      fi
      info "Launching Mayor (Orchestrator) agent via ${active_cli}..."
      exec "$active_cli" ${final_args[@]+"${final_args[@]}"}
      ;;
    aider)
      [[ "$skip_perms" == "1" ]] && final_args+=("--yes-always")
      if (( ${#cli_args[@]} > 0 )); then
        final_args+=("${cli_args[@]}")
      fi
      info "Launching Mayor (Orchestrator) agent via ${active_cli}..."
      exec "$active_cli" ${final_args[@]+"${final_args[@]}"}
      ;;
    *)
      final_args+=("--agent" "$DEFAULT_MAYOR_PERSONA")
      [[ "$skip_perms" == "1" ]] && final_args+=("--dangerously-skip-permissions")
      if (( ${#cli_args[@]} > 0 )); then
        final_args+=("${cli_args[@]}")
      fi
      info "Launching Mayor (Orchestrator) agent via ${active_cli}..."
      exec "$active_cli" ${final_args[@]+"${final_args[@]}"}
      ;;
  esac
}

cmd_spawn() {
  require_tmux
  local repo_root
  repo_root=$(get_main_repo_root)
  ensure_git_excludes "$repo_root"
  local fdir
  fdir=$(fleet_dir "$repo_root")
  mkdir -p "$fdir"

  local raw_name=""
  local prompt=""
  local base_branch=""
  local layout="$DEFAULT_LAYOUT"
  local overflow_window=false
  local reuse_existing=false
  local worker_persona="$DEFAULT_WORKER_PERSONA"
  local skip_override=""
  local cli_override=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base)
        base_branch="$2"; shift 2 ;;
      --layout)
        layout="$2"; shift 2 ;;
      --overflow-window)
        overflow_window=true; shift ;;
      --reuse)
        reuse_existing=true; shift ;;
      --agent)
        worker_persona="$2"; shift 2 ;;
      --cli)
        [[ $# -ge 2 ]] || die "missing value for --cli"
        cli_override="$2"; shift 2 ;;
      --cli=*)
        cli_override="${1#*=}"; shift ;;
      --dangerously-skip-permissions|--dangerously-bypass-approvals-and-sandbox)
        skip_override="1"; shift ;;
      --no-skip-permissions)
        skip_override="0"; shift ;;
      -h|--help)
        usage; exit 0 ;;
      -*)
        die "unknown flag for spawn: $1" ;;
      *)
        if [[ -z "$raw_name" ]]; then
          raw_name="$1"
        elif [[ -z "$prompt" ]]; then
          prompt="$1"
        else
          prompt="${prompt} $1"
        fi
        shift ;;
    esac
  done

  [[ -n "$raw_name" ]] || die "usage: wt-fleet spawn <worker-name> [\"initial prompt\"] [--base <branch>] [--reuse] [--dangerously-skip-permissions|--no-skip-permissions]"
  local name
  name=$(sanitize_name "$raw_name")
  [[ -n "$name" && "$name" != "mayor" ]] || die "invalid worker name: '$raw_name' (cannot be empty or 'mayor')"

  local mayor_pane
  mayor_pane=$(ensure_mayor_pane)
  local skip_perms
  skip_perms=$(resolve_skip_permissions "$repo_root" "$skip_override")

  # Check if worker already has a live pane
  local existing_pane
  existing_pane=$(resolve_pane_quiet "$name" "$repo_root")
  if pane_is_alive "$existing_pane"; then
    if $reuse_existing && [[ -n "$prompt" ]]; then
      info "Worker '$name' is already running in pane ${existing_pane}; routing prompt via 'wt-fleet prompt'..."
      cmd_prompt "$name" "$prompt"
      return 0
    fi
    die "Worker '$name' already has an active pane (${existing_pane}). Use 'wt-fleet prompt $name \"...\"' to message it, or 'wt-fleet teardown $name' to remove it."
  fi

  # Check max panes in Mayor's window
  local mayor_win
  mayor_win=$(tmux display-message -t "$mayor_pane" -p '#{session_name}:#{window_index}')
  local current_panes
  current_panes=$(tmux list-panes -t "$mayor_win" | wc -l | tr -d ' ')

  local target_win="$mayor_win"
  local create_new_win=false
  if (( current_panes >= MAX_PANES_PER_WINDOW )); then
    if $overflow_window; then
      create_new_win=true
    else
      warn "Window ${mayor_win} already has ${current_panes}/${MAX_PANES_PER_WINDOW} panes."
      die "Max ${MAX_PANES_PER_WINDOW} panes reached in current window. Re-prompt an existing worker with 'wt-fleet prompt <name> \"...\"', tear down a finished worker with 'wt-fleet teardown <name>', or pass '--overflow-window'."
    fi
  fi

  # Resolve base branch
  if [[ -z "$base_branch" ]]; then
    base_branch=$(git -C "$repo_root" branch --show-current 2>/dev/null || true)
    [[ -n "$base_branch" ]] || base_branch="HEAD"
  fi

  local branch_name="agent/${name}"
  local worktree_path="${repo_root}/.worktrees/${name}"

  # Create or reuse git worktree
  if [[ -d "$worktree_path" ]]; then
    info "Reusing existing worktree at ${worktree_path} (branch ${branch_name})"
  else
    info "Creating git worktree .worktrees/${name} on branch ${branch_name} (from ${base_branch})..."
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/${branch_name}"; then
      git -C "$repo_root" worktree add "$worktree_path" "$branch_name"
    else
      git -C "$repo_root" worktree add -b "$branch_name" "$worktree_path" "$base_branch"
    fi

    # Copy untracked .env files if present in main repo root
    for env_candidate in .env .env.local .env.development.local; do
      if [[ -f "${repo_root}/${env_candidate}" && ! -f "${worktree_path}/${env_candidate}" ]]; then
        cp "${repo_root}/${env_candidate}" "${worktree_path}/${env_candidate}"
        info "Copied ${env_candidate} into worktree"
      fi
    done

    # Run optional repo hook (.wt-setup) if executable
    if [[ -x "${repo_root}/.wt-setup" ]]; then
      info "Running .wt-setup hook in worktree..."
      (cd "$worktree_path" && "${repo_root}/.wt-setup" "$name" "$branch_name")
    fi
  fi

  local port_offset
  port_offset=$(allocate_port_offset "$fdir")

  # Create tmux pane in the same window (up to MAX_PANES_PER_WINDOW)
  local new_pane=""
  if $create_new_win; then
    new_pane=$(tmux new-window -d -n "wt:${name}" -c "$worktree_path" -P -F '#{pane_id}')
  else
    new_pane=$(tmux split-window -d -h -t "$target_win" -c "$worktree_path" -P -F '#{pane_id}')
    rebalance_window "$target_win" "$layout"
    # Keep cursor focus on the mayor pane
    tmux select-pane -t "$mayor_pane" >/dev/null 2>&1 || true
  fi

  # Label pane for native lookup and tmux border status
  pane_set_label "$new_pane" "$name"
  tmux set-option -p -t "$new_pane" @branch "$branch_name" >/dev/null 2>&1 || true

  # Write task file inside the worktree
  local task_file="${worktree_path}/.wt-task.md"
  cat > "$task_file" <<EOF
# Worker Task Brief: ${name}

- **Worker Label**: \`${name}\`
- **Assigned Pane**: \`${new_pane}\`
- **Mayor (Orchestrator) Pane**: \`${mayor_pane}\`
- **Git Branch**: \`${branch_name}\` (based on \`${base_branch}\`)
- **Worktree Path**: \`${worktree_path}\`
- **Port Offset**: \`${port_offset}\` (e.g., use port \$((3000 + ${port_offset})) for dev servers)

## Instructions
1. Stay strictly inside \`${worktree_path}\` on branch \`${branch_name}\`. Do not touch files in the parent repo root.
2. Implement the task below, run tests/builds to verify, and commit your changes cleanly to \`${branch_name}\`.
3. When you finish (or if you are blocked and need clarification), notify the Mayor pane by running:
   \`\`\`bash
   wt-fleet reply "[DONE] <concise summary of commits and test verification>"
   \`\`\`
   or:
   \`\`\`bash
   wt-fleet reply "[BLOCKED] <concise question for the Mayor>"
   \`\`\`

## Initial Task
${prompt:-Await instructions from Mayor.}
EOF

  # Save worker state
  local init_status="IDLE"
  [[ -n "$prompt" ]] && init_status="WORKING"
  local env_file="${fdir}/${name}.env"
  cat > "$env_file" <<EOF
WORKER_NAME=$(printf '%q' "$name")
BRANCH=$(printf '%q' "$branch_name")
BASE_BRANCH=$(printf '%q' "$base_branch")
WORKTREE_PATH=$(printf '%q' "$worktree_path")
PANE_ID=$(printf '%q' "$new_pane")
MAYOR_PANE=$(printf '%q' "$mayor_pane")
PORT_OFFSET=$(printf '%q' "$port_offset")
SKIP_PERMISSIONS=$(printf '%q' "$skip_perms")
STATUS=$(printf '%q' "$init_status")
REVIEW_ROUND="0"
CREATED_AT=$(printf '%q' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")")
LAST_TASK=$(printf '%q' "${prompt:-(spawned, awaiting task)}")
LAST_REPLY=""
EOF

  update_registry_md "$repo_root"

  # Construct startup command inside the worker pane.
  # Guard against Linux PTY 4KB MAX_CANON line buffer limit by truncating inline prompt > 400 chars
  # while preserving the full task specification in ${worktree_path}/.wt-task.md.
  local boot_prompt=""
  if [[ -n "$prompt" ]]; then
    local inline_prompt="${prompt//$'\n'/ }"
    if (( ${#prompt} > 400 )); then
      inline_prompt="${inline_prompt:0:400}... (see .wt-task.md for full task specification)"
    fi
    boot_prompt="You are Worker '${name}' in isolated git worktree '${worktree_path}' on branch '${branch_name}' (base: '${base_branch}'). Read .wt-task.md for full context. Execute your assigned task, commit your verified changes to '${branch_name}', and when finished or blocked run: wt-fleet reply \"[DONE|BLOCKED] <concise summary>\". Task: ${inline_prompt}"
  fi

  local active_cli
  active_cli=$(resolve_agent_cli "$repo_root" "$cli_override")
  local cli_invocation
  cli_invocation=$(build_worker_launch_cmd "$active_cli" "$worker_persona" "$boot_prompt" "$skip_perms")
  local launch_cmd="export WT_WORKER_NAME=$(printf '%q' "$name") WT_BRANCH=$(printf '%q' "$branch_name") WT_BASE_BRANCH=$(printf '%q' "$base_branch") WT_MAYOR_PANE=$(printf '%q' "$mayor_pane") WT_PORT_OFFSET=$(printf '%q' "$port_offset") WT_SKIP_PERMISSIONS=$(printf '%q' "$skip_perms") WT_AGENT_CLI=$(printf '%q' "$active_cli"); ${cli_invocation}"

  tmux send-keys -t "$new_pane" -l -- "$launch_cmd"
  tmux send-keys -t "$new_pane" Enter

  info "Spawned worker '${name}' in pane ${new_pane} (cli: ${active_cli}, branch: ${branch_name}, path: ${worktree_path})"
}

cmd_dispatch() {
  require_tmux
  local raw_name=""
  local prompt=""
  local spawn_flags=()
  local prompt_flags=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base|--layout|--agent|--cli)
        [[ $# -ge 2 ]] || die "missing value for $1"
        spawn_flags+=("$1" "$2")
        shift 2
        ;;
      --cli=*)
        spawn_flags+=("--cli" "${1#*=}")
        shift
        ;;
      --delivery)
        [[ $# -ge 2 ]] || die "missing value for --delivery (expected: smart, inbox, or push)"
        prompt_flags+=("--delivery" "$2")
        shift 2
        ;;
      --delivery=*)
        prompt_flags+=("--delivery" "${1#*=}")
        shift
        ;;
      --overflow-window|--reuse|--dangerously-skip-permissions|--no-skip-permissions)
        spawn_flags+=("$1")
        shift
        ;;
      -h|--help)
        usage; exit 0 ;;
      -*)
        die "unknown flag for dispatch: $1" ;;
      *)
        if [[ -z "$raw_name" ]]; then
          raw_name="$1"
        elif [[ -z "$prompt" ]]; then
          prompt="$1"
        else
          prompt="${prompt} $1"
        fi
        shift
        ;;
    esac
  done

  [[ -n "$raw_name" && -n "$prompt" ]] || die "usage: wt-fleet dispatch <worker-name> \"<prompt>\" [--base <branch>] [--cli <claude|codex|gemini>] [--dangerously-skip-permissions|--no-skip-permissions]"
  local repo_root
  repo_root=$(get_main_repo_root)
  local name
  name=$(sanitize_name "$raw_name")
  local existing_pane
  existing_pane=$(resolve_pane_quiet "$name" "$repo_root")
  if pane_is_alive "$existing_pane"; then
    cmd_prompt ${prompt_flags[@]+"${prompt_flags[@]}"} "$name" "$prompt"
  else
    cmd_spawn "$name" "$prompt" ${spawn_flags[@]+"${spawn_flags[@]}"}
  fi
}

cmd_prompt() {
  require_tmux
  local delivery_mode="${WT_DELIVERY_MODE:-$DEFAULT_DELIVERY_MODE}"
  local raw_name=""
  local prompt_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --delivery)
        [[ $# -ge 2 ]] || die "missing value for --delivery (expected: smart, inbox, or push)"
        delivery_mode="$2"
        shift 2
        ;;
      --delivery=*)
        delivery_mode="${1#*=}"
        shift
        ;;
      -h|--help)
        usage; exit 0 ;;
      *)
        if [[ -z "$raw_name" ]]; then
          raw_name="$1"
        else
          prompt_parts+=("$1")
        fi
        shift
        ;;
    esac
  done

  validate_delivery_mode "$delivery_mode"
  [[ -n "$raw_name" && ${#prompt_parts[@]} -ge 1 ]] || die "usage: wt-fleet prompt <worker-name> \"<follow-up prompt>\" [--delivery <smart|inbox|push>]"
  local repo_root
  repo_root=$(get_main_repo_root)
  local fdir
  fdir=$(fleet_dir "$repo_root")

  local name
  name=$(sanitize_name "$raw_name")
  local prompt="${prompt_parts[*]}"

  local target_pane
  target_pane=$(resolve_pane_quiet "$name" "$repo_root")
  pane_is_alive "$target_pane" || die "No active pane found for worker '${name}'. Run 'wt-fleet status' or respawn with 'wt-fleet spawn ${name} \"...\"'."

  local env_file="${fdir}/${name}.env"
  if [[ -f "$env_file" ]]; then
    # shellcheck disable=SC1090
    source "$env_file"
    cat > "$env_file" <<EOF
WORKER_NAME=$(printf '%q' "$WORKER_NAME")
BRANCH=$(printf '%q' "$BRANCH")
BASE_BRANCH=$(printf '%q' "$BASE_BRANCH")
WORKTREE_PATH=$(printf '%q' "$WORKTREE_PATH")
PANE_ID=$(printf '%q' "$target_pane")
MAYOR_PANE=$(printf '%q' "${MAYOR_PANE:-}")
PORT_OFFSET=$(printf '%q' "${PORT_OFFSET:-100}")
SKIP_PERMISSIONS=$(printf '%q' "${SKIP_PERMISSIONS:-0}")
STATUS="WORKING"
REVIEW_ROUND=$(printf '%q' "${REVIEW_ROUND:-0}")
CREATED_AT=$(printf '%q' "${CREATED_AT:-}")
LAST_TASK=$(printf '%q' "$prompt")
LAST_REPLY=$(printf '%q' "${LAST_REPLY:-}")
EOF
    if [[ -d "$WORKTREE_PATH" ]]; then
      {
        echo ""
        echo "## Follow-up Task ($(date -u +"%Y-%m-%dT%H:%M:%SZ"))"
        echo "$prompt"
      } >> "${WORKTREE_PATH}/.wt-task.md"
    fi
  fi

  local formatted_msg="${prompt} (When finished or blocked, run: wt-fleet reply \"[DONE|BLOCKED] <concise summary>\")"
  pane_send_message "$target_pane" "$formatted_msg" "$delivery_mode" "$name" "$repo_root"
  update_registry_md "$repo_root"
  if [[ "${LAST_DELIVERY_RESULT:-}" != "queued" ]]; then
    info "Sent prompt to worker '${name}' (pane ${target_pane})."
  fi
}

cmd_reply() {
  require_tmux
  local delivery_mode="${WT_DELIVERY_MODE:-$DEFAULT_DELIVERY_MODE}"
  local msg_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --delivery)
        [[ $# -ge 2 ]] || die "missing value for --delivery (expected: smart, inbox, or push)"
        delivery_mode="$2"
        shift 2
        ;;
      --delivery=*)
        delivery_mode="${1#*=}"
        shift
        ;;
      -h|--help)
        usage; exit 0 ;;
      *)
        msg_parts+=("$1")
        shift
        ;;
    esac
  done

  validate_delivery_mode "$delivery_mode"
  [[ ${#msg_parts[@]} -ge 1 ]] || die "usage: wt-fleet reply [--delivery <smart|inbox|push>] \"[DONE|BLOCKED] <summary>\""
  local message="${msg_parts[*]}"

  local repo_root
  repo_root=$(get_main_repo_root)
  local fdir
  fdir=$(fleet_dir "$repo_root")

  local worker_name="${WT_WORKER_NAME:-}"
  if [[ -z "$worker_name" && -n "${TMUX_PANE:-}" ]]; then
    worker_name=$(tmux display-message -t "$TMUX_PANE" -p '#{@name}' 2>/dev/null || true)
  fi

  local mayor_pane
  mayor_pane=$(resolve_pane_quiet "mayor" "$repo_root")
  if ! pane_is_alive "$mayor_pane" && [[ -n "${WT_MAYOR_PANE:-}" ]]; then
    mayor_pane="$WT_MAYOR_PANE"
  fi
  pane_is_alive "$mayor_pane" || die "Cannot find 'mayor' pane to reply to."

  if [[ -n "$worker_name" && "$worker_name" != "mayor" && -f "${fdir}/${worker_name}.env" ]]; then
    # shellcheck disable=SC1090
    source "${fdir}/${worker_name}.env"
    local new_status="AWAITING_REVIEW"
    if [[ "$message" == *"[BLOCKED]"* || "$message" == *"BLOCKED:"* ]]; then
      new_status="BLOCKED"
    elif [[ "$message" == *"[PROGRESS]"* ]]; then
      new_status="WORKING"
    fi
    cat > "${fdir}/${worker_name}.env" <<EOF
WORKER_NAME=$(printf '%q' "$WORKER_NAME")
BRANCH=$(printf '%q' "$BRANCH")
BASE_BRANCH=$(printf '%q' "$BASE_BRANCH")
WORKTREE_PATH=$(printf '%q' "$WORKTREE_PATH")
PANE_ID=$(printf '%q' "${PANE_ID:-}")
MAYOR_PANE=$(printf '%q' "$mayor_pane")
PORT_OFFSET=$(printf '%q' "${PORT_OFFSET:-100}")
SKIP_PERMISSIONS=$(printf '%q' "${SKIP_PERMISSIONS:-0}")
STATUS=$(printf '%q' "$new_status")
REVIEW_ROUND=$(printf '%q' "${REVIEW_ROUND:-0}")
CREATED_AT=$(printf '%q' "${CREATED_AT:-}")
LAST_TASK=$(printf '%q' "${LAST_TASK:-}")
LAST_REPLY=$(printf '%q' "$message")
EOF
  fi

  pane_send_message "$mayor_pane" "$message" "$delivery_mode" "mayor" "$repo_root"
  update_registry_md "$repo_root"
  if [[ "${LAST_DELIVERY_RESULT:-}" != "queued" ]]; then
    info "Delivered reply to mayor (${mayor_pane})."
  fi
}

cmd_inbox() {
  local repo_root
  repo_root=$(get_main_repo_root)
  local fdir
  fdir=$(fleet_dir "$repo_root")
  mkdir -p "$fdir"
  local ibox
  ibox=$(inbox_file "$repo_root")

  local action="list"
  local inject=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      list|--list)
        action="list"; shift ;;
      --clear|clear)
        action="clear"; shift ;;
      --flush|flush)
        action="flush"; shift ;;
      --inject)
        inject=true; shift ;;
      -h|--help)
        usage; exit 0 ;;
      *)
        die "unknown flag for inbox: $1 (usage: wt-fleet inbox [list|--flush [--inject]|--clear])" ;;
    esac
  done

  case "$action" in
    list)
      if [[ -s "$ibox" ]]; then
        cat "$ibox"
      else
        echo "(inbox empty)"
      fi
      ;;
    clear)
      rm -f "$ibox"
      update_registry_md "$repo_root"
      info "Cleared inbox (${ibox})."
      ;;
    flush)
      if [[ ! -s "$ibox" ]]; then
        echo "(inbox empty)"
        return 0
      fi
      cat "$ibox"
      if $inject; then
        require_tmux
        local mayor_pane
        mayor_pane=$(resolve_pane_quiet "mayor" "$repo_root")
        if pane_is_alive "$mayor_pane" && pane_is_safe_to_inject "$mayor_pane"; then
          while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -n "$line" ]] || continue
            tmux send-keys -t "$mayor_pane" -l -- "[wt-fleet inbox] ${line}"
            sleep 0.15
            tmux send-keys -t "$mayor_pane" Enter
          done < "$ibox"
          info "Injected flushed inbox messages into mayor pane (${mayor_pane})."
        else
          warn "Mayor pane (${mayor_pane:-?}) is busy/unsafe; printed flushed messages without injecting."
        fi
      fi
      rm -f "$ibox"
      update_registry_md "$repo_root"
      ;;
  esac
}

cmd_review_status() {
  local repo_root
  repo_root=$(get_main_repo_root)
  local fdir
  fdir=$(fleet_dir "$repo_root")
  [[ $# -ge 2 ]] || die "usage: wt-fleet review-status <worker-name> <REVIEWING|APPROVED|CHANGES_REQUESTED|ESCALATED> [\"summary\"]"

  local name
  name=$(sanitize_name "$1")
  local verdict="$2"
  shift 2
  local summary="${*:-}"

  local env_file="${fdir}/${name}.env"
  [[ -f "$env_file" ]] || die "unknown worker '${name}'"
  # shellcheck disable=SC1090
  source "$env_file"

  local round="${REVIEW_ROUND:-0}"
  local new_status="$verdict"
  case "$verdict" in
    REVIEWING)
      new_status="REVIEWING(R$((round + 1)))"
      ;;
    CHANGES_REQUESTED)
      round=$((round + 1))
      new_status="CHANGES_REQ(R${round})"
      ;;
    APPROVED)
      new_status="APPROVED"
      ;;
    ESCALATED)
      new_status="ESCALATED"
      ;;
  esac

  local updated_reply="${LAST_REPLY:-}"
  if [[ -n "$summary" ]]; then
    updated_reply="[${new_status}] ${summary}"
  fi

  cat > "$env_file" <<EOF
WORKER_NAME=$(printf '%q' "$WORKER_NAME")
BRANCH=$(printf '%q' "$BRANCH")
BASE_BRANCH=$(printf '%q' "$BASE_BRANCH")
WORKTREE_PATH=$(printf '%q' "$WORKTREE_PATH")
PANE_ID=$(printf '%q' "${PANE_ID:-}")
MAYOR_PANE=$(printf '%q' "${MAYOR_PANE:-}")
PORT_OFFSET=$(printf '%q' "${PORT_OFFSET:-100}")
SKIP_PERMISSIONS=$(printf '%q' "${SKIP_PERMISSIONS:-0}")
STATUS=$(printf '%q' "$new_status")
REVIEW_ROUND=$(printf '%q' "$round")
CREATED_AT=$(printf '%q' "${CREATED_AT:-}")
LAST_TASK=$(printf '%q' "${LAST_TASK:-}")
LAST_REPLY=$(printf '%q' "$updated_reply")
EOF

  update_registry_md "$repo_root"
  info "Updated worker '${name}' review status -> ${new_status} (round ${round})."
}

cmd_staff() {
  local repo_root
  repo_root=$(get_main_repo_root)
  local cli_override=""
  local skip_override=""
  local prompt=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cli)
        [[ $# -ge 2 ]] || die "missing value for --cli"
        cli_override="$2"
        shift 2
        ;;
      --cli=*)
        cli_override="${1#*=}"
        shift
        ;;
      --dangerously-skip-permissions)
        skip_override="1"
        shift
        ;;
      --no-skip-permissions)
        skip_override="0"
        shift
        ;;
      -h|--help)
        usage; exit 0 ;;
      *)
        if [[ -z "$prompt" ]]; then
          prompt="$1"
        else
          prompt="${prompt} $1"
        fi
        shift
        ;;
    esac
  done

  [[ -n "$prompt" ]] || die "usage: wt-fleet staff [--cli <claude|codex|gemini>] \"<prompt>\""

  local active_cli
  active_cli=$(resolve_agent_cli "$repo_root" "$cli_override")
  local skip_perms
  skip_perms=$(resolve_skip_permissions "$repo_root" "$skip_override")

  info "Running headless Staff Engineer via ${active_cli}..."
  cd "$repo_root"

  case "$active_cli" in
    claude*)
      local flags=(--agent staff -p)
      if [[ "$skip_perms" == "1" ]]; then
        flags+=(--dangerously-skip-permissions)
      fi
      "$active_cli" "${flags[@]}" "$prompt"
      ;;
    codex*)
      local flags=(exec -C "$repo_root")
      if [[ "$skip_perms" == "1" ]]; then
        flags+=(--dangerously-bypass-approvals-and-sandbox)
      else
        flags+=(--full-auto)
      fi
      "$active_cli" "${flags[@]}" "Adopt the Staff Engineer persona and rubric in ~/.codex/agents/staff.md and ~/.codex/skills/staff-review/SKILL.md. ${prompt}"
      ;;
    aider*)
      die "wt-fleet staff does not support headless execution for aider (supported: claude, codex, gemini)"
      ;;
    *)
      local flags=(--agent staff -p)
      if [[ "$skip_perms" == "1" ]]; then
        flags+=(--dangerously-skip-permissions)
      fi
      "$active_cli" "${flags[@]}" "$prompt"
      ;;
  esac
}

cmd_review() {
  local repo_root
  repo_root=$(get_main_repo_root)
  local fdir
  fdir=$(fleet_dir "$repo_root")
  local cli_override=""
  local skip_override=""
  local raw_name=""
  local summary=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cli)
        [[ $# -ge 2 ]] || die "missing value for --cli"
        cli_override="$2"
        shift 2
        ;;
      --cli=*)
        cli_override="${1#*=}"
        shift
        ;;
      --dangerously-skip-permissions)
        skip_override="1"
        shift
        ;;
      --no-skip-permissions)
        skip_override="0"
        shift
        ;;
      -h|--help)
        usage; exit 0 ;;
      *)
        if [[ -z "$raw_name" ]]; then
          raw_name="$1"
        elif [[ -z "$summary" ]]; then
          summary="$1"
        else
          summary="${summary} $1"
        fi
        shift
        ;;
    esac
  done

  [[ -n "$raw_name" ]] || die "usage: wt-fleet review <worker-name> [summary] [--cli <claude|codex|gemini>]"
  local name
  name=$(sanitize_name "$raw_name")
  local env_file="${fdir}/${name}.env"
  [[ -f "$env_file" ]] || die "unknown worker '${name}'"
  # shellcheck disable=SC1090
  source "$env_file"

  local worker_summary="${summary:-${LAST_REPLY:-(no worker summary recorded)}}"
  local review_prompt="MODE B (Code Review Gate): Review worker '${name}' in worktree '${WORKTREE_PATH}' on branch '${BRANCH}' (base: '${BASE_BRANCH}'). Worker summary: ${worker_summary}. Apply the 4-dimension Staff Engineer rubric, update wt-fleet review-status, write ${WORKTREE_PATH}/.wt-review.md, and if CHANGES_REQUESTED (round < 3), directly re-prompt the worker via wt-fleet prompt."

  local staff_args=()
  [[ -n "$cli_override" ]] && staff_args+=(--cli "$cli_override")
  if [[ "$skip_override" == "1" ]]; then
    staff_args+=(--dangerously-skip-permissions)
  elif [[ "$skip_override" == "0" ]]; then
    staff_args+=(--no-skip-permissions)
  fi
  cmd_staff "${staff_args[@]}" "$review_prompt"
}

cmd_read() {
  require_tmux
  local repo_root
  repo_root=$(get_main_repo_root)
  [[ $# -ge 1 ]] || die "usage: wt-fleet read <worker-name> [lines]"
  local name
  name=$(sanitize_name "$1")
  local lines="${2:-40}"
  local target_pane
  target_pane=$(resolve_pane_quiet "$name" "$repo_root")
  pane_is_alive "$target_pane" || die "No active pane found for worker '${name}'"
  pane_capture "$target_pane" "$lines"
}

cmd_status() {
  require_tmux
  local repo_root
  repo_root=$(get_main_repo_root)
  if [[ "${1:-}" == "--watch" ]]; then
    if command -v watch >/dev/null 2>&1; then
      watch -n 2 -c "$0 status"
    else
      while true; do
        clear
        "$0" status
        sleep 2
      done
    fi
    return 0
  fi

  update_registry_md "$repo_root"
  local fdir
  fdir=$(fleet_dir "$repo_root")
  local mayor_pane
  mayor_pane=$(resolve_pane_quiet "mayor" "$repo_root")
  local mayor_win=""
  if pane_is_alive "$mayor_pane"; then
    mayor_win=$(tmux display-message -t "$mayor_pane" -p '#{session_name}:#{window_index}')
  fi
  local win_panes="?"
  if [[ -n "$mayor_win" ]]; then
    win_panes=$(tmux list-panes -t "$mayor_win" 2>/dev/null | wc -l | tr -d ' ')
  fi

  local ibox
  ibox=$(inbox_file "$repo_root")
  local icount
  icount=$(inbox_count "$repo_root")
  local inbox_badge="  |  Inbox: \033[1;32m0 queued\033[0m"
  if (( icount > 0 )); then
    inbox_badge="  |  Inbox: \033[1;33m${icount} queued\033[0m"
  fi

  local skip_perms
  skip_perms=$(resolve_skip_permissions "$repo_root")
  local skip_badge=""
  if [[ "$skip_perms" == "1" ]]; then
    skip_badge="  |  Permissions: \033[1;31mSKIP (--dangerously-skip-permissions)\033[0m"
  fi

  local active_cli
  active_cli=$(resolve_agent_cli "$repo_root")

  printf "\033[1;36m=== Worktree Fleet Status (%s) ===\033[0m\n" "$(basename "$repo_root")"
  printf "Mayor Pane: \033[1;32m%s\033[0m  |  Window Panes: \033[1;33m%s/%s\033[0m  |  CLI: \033[1;35m%s\033[0m%b%b\n\n" \
    "${mayor_pane:-unregistered}" "$win_panes" "$MAX_PANES_PER_WINDOW" "$active_cli" "$inbox_badge" "$skip_badge"

  printf "%-16s %-8s %-15s %-22s %-8s %-10s %s\n" \
    "WORKER" "PANE" "STATUS" "BRANCH" "AHEAD" "TREE" "LAST TASK / REPLY"
  printf "%-16s %-8s %-15s %-22s %-8s %-10s %s\n" \
    "------" "----" "------" "------" "-----" "----" "-----------------"

  local found=false
  for env_file in "$fdir"/*.env; do
    [[ -f "$env_file" ]] || continue
    [[ "$(basename "$env_file")" == "mayor.env" ]] && continue
    found=true
    # shellcheck disable=SC1090
    source "$env_file"
    local live_pane
    live_pane=$(resolve_pane_quiet "$WORKER_NAME" "$repo_root")
    local st="$STATUS"
    if ! pane_is_alive "$live_pane"; then
      live_pane="closed"
      st="PANE_CLOSED"
    fi
    local ahead="0"
    local dirty="clean"
    if [[ -d "$WORKTREE_PATH" ]]; then
      ahead=$(git -C "$WORKTREE_PATH" rev-list --count "${BASE_BRANCH}..HEAD" 2>/dev/null || echo "?")
      if [[ -n "$(git -C "$WORKTREE_PATH" status --porcelain 2>/dev/null)" ]]; then
        dirty="modified"
      fi
    else
      dirty="missing"
    fi
    local note="${LAST_REPLY:-$LAST_TASK}"
    note="${note//$'\n'/ }"
    if (( ${#note} > 52 )); then
      note="${note:0:49}..."
    fi
    printf "%-16s %-8s %-15s %-22s %-8s %-10s %s\n" \
      "$WORKER_NAME" "$live_pane" "$st" "$BRANCH" "+${ahead}" "$dirty" "$note"
  done

  if ! $found; then
    echo "(no active worktree workers)"
  fi

  if (( icount > 0 )) && [[ -s "$ibox" ]]; then
    printf "\n\033[1;33m=== Queued Inbox Messages (%s queued — run 'wt-fleet inbox --flush' to clear) ===\033[0m\n" "$icount"
    cat "$ibox"
  fi
}

cmd_diff() {
  local repo_root
  repo_root=$(get_main_repo_root)
  local fdir
  fdir=$(fleet_dir "$repo_root")
  [[ $# -ge 1 ]] || die "usage: wt-fleet diff <worker-name> [--stat]"
  local name
  name=$(sanitize_name "$1")
  shift
  local env_file="${fdir}/${name}.env"
  [[ -f "$env_file" ]] || die "unknown worker '${name}'"
  # shellcheck disable=SC1090
  source "$env_file"
  [[ -d "$WORKTREE_PATH" ]] || die "worktree directory missing: ${WORKTREE_PATH}"

  info "Commits on ${BRANCH} (since ${BASE_BRANCH}):"
  git -C "$WORKTREE_PATH" log --oneline "${BASE_BRANCH}..HEAD" || true
  echo ""
  info "Uncommitted working tree status in ${WORKTREE_PATH}:"
  git -C "$WORKTREE_PATH" status -s || true
  echo ""
  info "Diff against ${BASE_BRANCH}:"
  git -C "$WORKTREE_PATH" diff "${BASE_BRANCH}" "$@"
}

cmd_merge() {
  local repo_root
  repo_root=$(get_main_repo_root)
  local fdir
  fdir=$(fleet_dir "$repo_root")
  [[ $# -ge 1 ]] || die "usage: wt-fleet merge <worker-name> [--squash] [--teardown]"
  local name
  name=$(sanitize_name "$1")
  shift

  local squash=false
  local teardown_after=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --squash) squash=true; shift ;;
      --teardown) teardown_after=true; shift ;;
      *) die "unknown flag for merge: $1" ;;
    esac
  done

  local env_file="${fdir}/${name}.env"
  [[ -f "$env_file" ]] || die "unknown worker '${name}'"
  # shellcheck disable=SC1090
  source "$env_file"

  if [[ -d "$WORKTREE_PATH" && -n "$(git -C "$WORKTREE_PATH" status --porcelain 2>/dev/null)" ]]; then
    git -C "$WORKTREE_PATH" status -s >&2
    die "Worktree '${name}' has uncommitted changes. Prompt the worker to commit them first: wt-fleet prompt ${name} \"Please commit your pending changes\""
  fi

  info "Merging branch '${BRANCH}' into main repository (${repo_root})..."
  if $squash; then
    git -C "$repo_root" merge --squash "$BRANCH"
    info "Squash-merged '${BRANCH}' (staged in ${repo_root}; run 'git commit' to finalize)."
  else
    git -C "$repo_root" merge --no-ff -m "Merge branch '${BRANCH}' from worker ${name}" "$BRANCH"
    info "Successfully merged '${BRANCH}'."
  fi

  if $teardown_after; then
    cmd_teardown "$name"
  else
    cat > "$env_file" <<EOF
WORKER_NAME=$(printf '%q' "$WORKER_NAME")
BRANCH=$(printf '%q' "$BRANCH")
BASE_BRANCH=$(printf '%q' "$BASE_BRANCH")
WORKTREE_PATH=$(printf '%q' "$WORKTREE_PATH")
PANE_ID=$(printf '%q' "${PANE_ID:-}")
MAYOR_PANE=$(printf '%q' "${MAYOR_PANE:-}")
PORT_OFFSET=$(printf '%q' "${PORT_OFFSET:-100}")
SKIP_PERMISSIONS=$(printf '%q' "${SKIP_PERMISSIONS:-0}")
STATUS="MERGED"
REVIEW_ROUND=$(printf '%q' "${REVIEW_ROUND:-0}")
CREATED_AT=$(printf '%q' "${CREATED_AT:-}")
LAST_TASK=$(printf '%q' "${LAST_TASK:-}")
LAST_REPLY=$(printf '%q' "${LAST_REPLY:-}")
EOF
    update_registry_md "$repo_root"
  fi
}

cmd_teardown() {
  require_tmux
  local repo_root
  repo_root=$(get_main_repo_root)
  local fdir
  fdir=$(fleet_dir "$repo_root")
  [[ $# -ge 1 ]] || die "usage: wt-fleet teardown <worker-name|all> [--force]"

  local target_name="$1"
  shift
  local force=false
  if [[ "${1:-}" == "--force" || "${1:-}" == "-f" ]]; then
    force=true
  fi

  if [[ "$target_name" == "all" ]]; then
    for env_file in "$fdir"/*.env; do
      [[ -f "$env_file" ]] || continue
      [[ "$(basename "$env_file")" == "mayor.env" ]] && continue
      # shellcheck disable=SC1090
      source "$env_file"
      if $force; then
        cmd_teardown "$WORKER_NAME" --force
      else
        cmd_teardown "$WORKER_NAME"
      fi
    done
    return 0
  fi

  local name
  name=$(sanitize_name "$target_name")
  local env_file="${fdir}/${name}.env"
  local worktree_path="${repo_root}/.worktrees/${name}"
  local branch_name="agent/${name}"

  if [[ -f "$env_file" ]]; then
    # shellcheck disable=SC1090
    source "$env_file"
    worktree_path="${WORKTREE_PATH:-$worktree_path}"
    branch_name="${BRANCH:-$branch_name}"
  fi

  # 1. Close tmux pane if alive and rebalance window
  local live_pane
  live_pane=$(resolve_pane_quiet "$name" "$repo_root")
  if pane_is_alive "$live_pane"; then
    local win_target
    win_target=$(tmux display-message -t "$live_pane" -p '#{session_name}:#{window_index}' 2>/dev/null || true)
    info "Closing tmux pane ${live_pane} for worker '${name}'..."
    tmux kill-pane -t "$live_pane" >/dev/null 2>&1 || true
    if [[ -n "$win_target" ]]; then
      rebalance_window "$win_target" "$DEFAULT_LAYOUT"
    fi
  fi

  # 2. Remove git worktree
  if [[ -d "$worktree_path" ]]; then
    info "Removing git worktree ${worktree_path}..."
    rm -f "${worktree_path}/.wt-task.md" "${worktree_path}/.wt-review.md" "${worktree_path}/.wt-spec.md"
    if $force; then
      git -C "$repo_root" worktree remove --force "$worktree_path"
    else
      git -C "$repo_root" worktree remove "$worktree_path" \
        || die "Worktree '${name}' has untracked/modified files. Re-run with 'wt-fleet teardown ${name} --force' to discard."
    fi
  fi
  git -C "$repo_root" worktree prune >/dev/null 2>&1 || true

  # 3. Delete branch if merged (or if --force)
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/${branch_name}"; then
    if $force; then
      git -C "$repo_root" branch -D "$branch_name" >/dev/null 2>&1 || true
    else
      git -C "$repo_root" branch -d "$branch_name" >/dev/null 2>&1 \
        || warn "Branch '${branch_name}' is not fully merged; kept branch ref (pass --force to delete unmerged branch)."
    fi
  fi

  rm -f "$env_file"
  update_registry_md "$repo_root"
  info "Tore down worker '${name}'."
}

usage() {
  cat <<'EOF'
wt-fleet — Portable Git Worktree + tmux Multi-Agent Orchestrator (max 4 panes/window)
           Compatible with Claude Code (claude), OpenAI Codex (codex), and Gemini CLI (gemini).

Usage:
  wt-fleet [--cli <claude|codex|gemini>] [--dangerously-skip-permissions]
                                                   Init current pane as 'mayor' & launch Mayor
  wt-fleet init [--cli <cli>] [--dangerously-skip-permissions]
                                                   Label current pane as 'mayor' & init .worktrees/
  wt-fleet mayor [--cli <cli>] [--dangerously-skip-permissions] [cli-flags...]
                                                   Init current pane and launch Mayor in selected CLI
  wt-fleet spawn <name> "<prompt>" [options]       Create git worktree + tmux pane & start worker agent
      --base <branch>                              Base branch for worktree (default: current branch)
      --cli <claude|codex|gemini>                  Agent CLI binary (default: auto-detected or mayor's CLI)
      --reuse                                      If worker pane already exists, send prompt to it
      --layout <tiled|main-vertical|even-horizontal>
      --overflow-window                            Allow opening a new window if current has 4 panes
      --dangerously-skip-permissions               Launch worker with skip-permissions (inherited from mayor)
      --no-skip-permissions                        Override inherited skip-permissions for this worker
  wt-fleet dispatch <name> "<prompt>" [options]    Upsert: prompt existing worker or spawn new one
  wt-fleet prompt <name> "<follow-up prompt>" [--delivery <smart|inbox|push>]
                                                   Send follow-up instructions to existing worker pane
  wt-fleet reply [--delivery <smart|inbox|push>] "[DONE|BLOCKED] <summary>"
                                                   (Used by workers) Send status reply back to 'mayor'
                                                   (WT_DELIVERY_MODE=smart|inbox|push, default: smart)
  wt-fleet inbox [list|--flush [--inject]|--clear] View, flush, or clear queued replies from .worktrees/.fleet/inbox.log
  wt-fleet review <name> [summary] [--cli <cli>]   Run headless Staff Engineer Mode B code review gate for worker
  wt-fleet staff "<prompt>" [--cli <cli>]          Run headless Staff Engineer Mode A/B prompt
  wt-fleet review-status <name> <VERDICT> [msg]    (Used by staff) Set REVIEWING|APPROVED|CHANGES_REQUESTED|ESCALATED
  wt-fleet status [--watch]                        Show table of all active worktrees, panes, and branches
  wt-fleet read <name> [lines]                     Capture recent terminal output from worker pane
  wt-fleet diff <name> [--stat]                    Show commits and diff for worker's branch/worktree
  wt-fleet merge <name> [--squash] [--teardown]    Merge worker's branch into main repo (& optional teardown)
  wt-fleet teardown <name|all> [--force]           Kill worker pane, rebalance layout, remove worktree
EOF
}

# --- Main Dispatch ---

main() {
  local top_flags=()
  local has_top_action=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dangerously-skip-permissions|--no-skip-permissions)
        top_flags+=("$1")
        has_top_action=true
        shift
        ;;
      --cli)
        [[ $# -ge 2 ]] || die "missing value for --cli"
        top_flags+=("--cli" "$2")
        has_top_action=true
        shift 2
        ;;
      --cli=*)
        top_flags+=("--cli" "${1#*=}")
        has_top_action=true
        shift
        ;;
      *)
        break
        ;;
    esac
  done

  local cmd=""
  if [[ $# -eq 0 && "$has_top_action" == true ]]; then
    cmd="mayor"
  else
    cmd="${1:-help}"
    shift || true
  fi

  case "$cmd" in
    init)                cmd_init "${top_flags[@]}" "$@" ;;
    mayor)               cmd_mayor "${top_flags[@]}" "$@" ;;
    spawn)               cmd_spawn "${top_flags[@]}" "$@" ;;
    dispatch)            cmd_dispatch "${top_flags[@]}" "$@" ;;
    prompt|send|msg)     cmd_prompt "$@" ;;
    reply)               cmd_reply "$@" ;;
    inbox)               cmd_inbox "$@" ;;
    review)              cmd_review "${top_flags[@]}" "$@" ;;
    staff)               cmd_staff "${top_flags[@]}" "$@" ;;
    review-status)       cmd_review_status "$@" ;;
    read)                cmd_read "$@" ;;
    status|list|ls)      cmd_status "$@" ;;
    diff)                cmd_diff "$@" ;;
    merge)               cmd_merge "$@" ;;
    teardown|rm|kill)    cmd_teardown "$@" ;;
    version|-v|--version) echo "wt-fleet v${VERSION}" ;;
    help|-h|--help|*)    usage ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
